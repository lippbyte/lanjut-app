# Dependencies
node_modules/
*/node_modules/
LANJUT_App/server/node_modules/

# Environment variables
.env
.env.local
.env.*.local
LANJUT_App/server/.env
LANJUT_App/server/.env.test
LANJUT_App/server/.env.local
!.env.example
!LANJUT_App/server/.env.example
# Templat saja (berisi placeholder). Berkas berisi nilai sungguhan —
# .env, .env.production, dst. — tetap diabaikan.
!LANJUT_App/server/.env.production.example
LANJUT_App/server/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

