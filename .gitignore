.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/

# Temporary / scratch audit scripts
MVP-PWA/scratch_*
scratch/

# APK hasil unduhan EAS. Harus di .gitignore root: EAS Build hanya membaca
# berkas ini saat mengemas proyek, jadi LANJUT_App/.gitignore tidak cukup
# (dibuktikan ulang 28 Sep: tanpa baris ini arsip EAS 221 MB, dengan 19 MB).
LANJUT_App/build/
# Cache & status server pengembangan Expo — sama alasannya, bukan bagian build.
LANJUT_App/.expo/
