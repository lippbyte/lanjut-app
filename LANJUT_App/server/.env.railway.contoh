# Contoh variabel lingkungan untuk service Node LANJUT di Railway (LANJUT_085).
# HANYA nama variabel dan komentar. JANGAN menulis nilai di berkas ini, dan jangan
# meng-commit nilai asli ke repo. Isi nilainya di tab Variables service Node di Railway.
# Server membaca semua variabel dari lingkungan (src/config/env.js); berkas .env tidak
# ikut ke Railway dan tidak dibutuhkan di sana.

# --- Umum -------------------------------------------------------------------------------
# Isi: production. Di produksi, CORS_ORIGINS wajib https:// dan TRUST_PROXY wajib diisi.
NODE_ENV=
# Port yang didengarkan server (process.env.PORT; bawaan 3000 bila kosong). Bila Railway
# mengisinya sendiri, biarkan kosong. Port target domain publik Railway harus sama.
PORT=
# Umur sesi masuk dalam hari (opsional, bawaan 90).
SESI_UMUR_HARI=

# --- Basis data (service MySQL di Railway) ----------------------------------------------
# Nama variabel yang diberikan service MySQL Railway (menurut docs.railway.com/guides/mysql):
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, MYSQL_URL
# (+ MYSQL_PUBLIC_URL bila akses publik dinyalakan). Server TIDAK membaca MYSQL_URL;
# isi kelima variabel di bawah dengan referensi ke service MySQL, sintaks
# ${{NAMA_SERVICE.NAMA_VARIABEL}}, misalnya DB_HOST ke MYSQLHOST milik service MySQL.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Akses dari luar ----------------------------------------------------------------------
# Asal (origin) web yang boleh memanggil API, dipisah koma, wajib https:// di produksi,
# tanpa "*". APK Android tidak mengirim Origin, jadi tidak perlu dicantumkan. Isi dengan
# domain landing (dan domain web app bila nanti ada).
CORS_ORIGINS=
# Jumlah proxy tepercaya di depan server (dipakai Express untuk X-Forwarded-For dan
# req.ip). Wajib diisi di produksi; isi 0 hanya bila server tidak di belakang proxy.
# Dokumentasi Railway tidak menyebut jumlah lompatan proxy-nya: mulai dari 1, lalu cek
# setelah deploy (lihat langkah PM di laporan LANJUT_085). Jangan isi true.
TRUST_PROXY=
# Header berisi IP klien asli yang ditulis proxy tepercaya, untuk batas laju per IP.
# Railway mendokumentasikan X-Real-IP sebagai IP klien: isi x-real-ip. Kosongkan bila
# server TIDAK berada di belakang proxy yang menulis header ini (header bisa dipalsukan).
HEADER_IP_KLIEN=

# --- Email (kode masuk & verifikasi). Kosong = fitur mati, server tetap menyala ------------
SMTP_HOST=
SMTP_PORT=
# true untuk TLS langsung (port 465); selain itu STARTTLS.
SMTP_SECURE=
SMTP_USER=
# Rahasia: isi hanya di Railway.
SMTP_PASSWORD=
SMTP_FROM=

# --- Masuk dengan Google. Client ID publik, boleh beberapa dipisah koma. Kosong = mati ----
GOOGLE_CLIENT_ID=

# --- AI lewat OpenRouter. Kosong = fitur AI mati (saklar ai_aktif di basis data tetap 0) --
# Rahasia: isi hanya di Railway.
OPENROUTER_API_KEY=
