# Templat variabel lingkungan untuk deployment produksi di Rumahweb
# (Skenario A — satu domain, frontend & backend same-origin, path /api/v1).
#
# JANGAN isi nilai sungguhan di berkas ini: templat ini dilacak git dan
# hanya boleh berisi PLACEHOLDER. Di server, salin menjadi `.env` di
# direktori `server/`, lalu isi nilai sungguhan di `.env` (diabaikan git) —
# lihat server/DEPLOYMENT-RUMAHWEB.md dan README.md bagian Deployment.
#
# Nama variabel HARUS sama persis dengan yang dibaca src/config/env.js —
# jangan mengganti nama (mis. DB_PASSWORD, bukan DB_PASS).

# Port HTTP tempat proses Node (Express) berjalan. Rumahweb (cPanel Node.js
# Selector) biasanya menugaskan port ini secara otomatis via reverse proxy —
# cocokkan dengan pengaturan aplikasi Node di cPanel, jangan asal isi 3000.
PORT=3000

# Wajib "production" di server tayang. Mengubah nilai ini menaikkan batas
# express-rate-limit ke angka produksi asli (§8.2 SDD) — TIDAK seperti
# NODE_ENV=test yang sengaja dilonggarkan untuk rangkaian tests/*.test.js.
NODE_ENV=production

# Koneksi MySQL. Di Rumahweb, MySQL biasanya satu server dengan aplikasi
# (DB_HOST=localhost) dan nama basis data/pengguna diawali prefix akun
# cPanel (mis. "namaakun_lanjut_v1"), BUKAN "lanjut_v1" polos — cek di
# cPanel > MySQL Databases sebelum mengisi.
DB_HOST=localhost
DB_PORT=3306
DB_USER=GANTI_DENGAN_USER_DB_RUMAHWEB
DB_PASSWORD=GANTI_DENGAN_SANDI_DB_RUMAHWEB
DB_NAME=GANTI_DENGAN_NAMA_DB_RUMAHWEB

# CORS — daftar asal yang diizinkan, dipisah koma, TIDAK PERNAH "*"
# (dikunci server/src/config/env.js). Pada deployment same-origin
# (Skenario A), nilai ini tetap wajib diisi walau CORS secara praktik
# tidak terpakai (frontend & backend satu domain) — env.js menolak
# menyala bila kosong. Ganti domain di bawah sesuai domain Rumahweb.
ASAL_DIIZINKAN=https://edilakso.my.id

# Umur sesi login dalam hari (bergulir/sliding, §5.3 SDD). 90 = usulan SDD.
SESI_UMUR_HARI=90

# Jumlah reverse proxy di depan Node. Kemungkinan 1 di cPanel/Passenger —
# pastikan ke Rumahweb (README.md §6).
JUMLAH_PROXY=1

# Folder data konten untuk `npm run benih`. Di Rumahweb yang diunggah hanya
# folder server/, jadi salin MVP-PWA/data ke server/data-konten (README.md
# §6, "Data konten untuk npm run benih").
LOKASI_DATA_KONTEN=data-konten
