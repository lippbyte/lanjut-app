# ==============================================================================
# LANJUT Server — Variabel Lingkungan
# Salin berkas ini menjadi .env dan isi nilainya. JANGAN PERNAH commit .env.
# ==============================================================================

# Port HTTP tempat server Express berjalan (bawaan: 3000)
PORT=4000

# Lingkungan aplikasi: development | test | production
NODE_ENV=production

# Koneksi basis data MySQL 8 / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lanjut_app
DB_PASSWORD=
DB_NAME=lanjut_db

# Daftar asal (origin) yang diizinkan CORS, dipisah koma (tanpa spasi).
# TIDAK PERNAH "*" (docs/SDD-Backend-Foundation.md §8.5).
# Di produksi: hanya domain web resmi HTTPS (mis. https://app.GANTI-DOMAIN).
# Di dev: mis. http://localhost:5500,http://127.0.0.1:5500,http://localhost:8081
CORS_ORIGINS=https://app.GANTI-DOMAIN
# Alias kompatibilitas lama (bila memakai ASAL_DIIZINKAN alih-alih CORS_ORIGINS)
# ASAL_DIIZINKAN=https://app.GANTI-DOMAIN

# Umur sesi login dalam hari (bergulir/sliding). SDD §5.3: bawaan 90 hari.
SESI_UMUR_HARI=90

# Konfigurasi reverse proxy tepercaya di depan Node (Nginx, PM2, Docker, Railway, cPanel).
# 0/false/kosong = koneksi langsung (lokal).
# 1 = 1 hop proxy (Nginx di depan Node).
# 'loopback' = percaya proxy di localhost (127.0.0.1/::1).
# Tanpa ini di belakang proxy, semua pengguna terlihat ber-IP sama dan batas laju terpicu bersamaan.
TRUST_PROXY=1
# Alias kompatibilitas lama:
# JUMLAH_PROXY=1

# Lokasi berkas *.json konten untuk `npm run benih`.
# Kosong = ../../MVP-PWA/data (dari folder server/).
# Pada server mandiri atau kontainer Docker, salin folder data lalu isi jalurnya di sini.
LOKASI_DATA_KONTEN=

# Integrasi Ngobrol Bareng LANJUT dengan AI via OpenRouter (LANJUT_051).
# Kosongkan di produksi sampai evaluasi keselamatan disetujui.
# Kosong = AI nonaktif (server tetap berjalan normal, menjawab 503 bila dipanggil).
# JANGAN PERNAH isi kunci rahasia di berkas contoh atau commit ke git.
OPENROUTER_API_KEY=

# URL dasar OpenRouter (opsional, bawaan: https://openrouter.ai/api/v1).
# Hanya diubah ke http://127.0.0.1:xxx untuk pengujian dengan server tiruan lokal.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
