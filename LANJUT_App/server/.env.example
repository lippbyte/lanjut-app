# Salin berkas ini menjadi .env dan isi nilainya. JANGAN commit .env.
# Tidak ada asumsi penyedia hosting tertentu di sini — nilai-nilai ini
# berlaku sama untuk lokal, staging (mis. Vercel/Railway), maupun produksi.

# Port HTTP tempat server Express berjalan.
PORT=

# Lingkungan: development | test | production
NODE_ENV=

# Koneksi MySQL 8. Untuk staging/produksi, isi dengan kredensial penyedia
# yang dipakai (mis. Railway, Rumahweb) — tidak ada nilai bawaan yang
# mengasumsikan satu penyedia tertentu.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Daftar asal (origin) yang diizinkan CORS, dipisah koma. Tidak pernah "*".
# Dev: PWA lewat Live Server = :5500; Expo Web (SDK 57, Metro) = :8081;
# :19006/:19000 hanya untuk Expo lama (webpack) atau `expo start --port`.
# Contoh dev: http://localhost:5500,http://127.0.0.1:5500,http://localhost:8081
ASAL_DIIZINKAN=

# Umur sesi login dalam hari (bergulir/sliding). Lihat SDD §5.3 — usul 90.
SESI_UMUR_HARI=

# Opsional. Jumlah reverse proxy tepercaya di depan server (0/kosong = tidak
# ada, untuk lokal). Di hosting (cPanel/Passenger, Railway) biasanya 1 —
# cek dokumentasi hostingnya. Tanpa ini, semua pengguna terlihat ber-IP sama
# dan batas laju per-IP berlaku untuk semua orang sekaligus.
JUMLAH_PROXY=

# Opsional. Folder berisi berkas *.json konten untuk `npm run benih`.
# Kosong = ../../MVP-PWA/data (seperti di laptop). Di hosting yang hanya
# menerima folder server/, salin folder data ke server/data-konten lalu isi
# `data-konten`. Boleh path lengkap, atau relatif terhadap folder server/.
LOKASI_DATA_KONTEN=
