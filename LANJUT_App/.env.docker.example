# =============================================================================
# Templat Environment untuk Dokploy (Docker Compose) — LANJUT_App
# Salin isi di bawah ini ke tab "Environment" pada layanan Compose di Dokploy.
# =============================================================================

# --- Lingkungan --------------------------------------------------------------
NODE_ENV=production

# --- Basis Data MySQL 8 (service `db`) ---------------------------------------
DB_ROOT_PASSWORD=GANTI_SANDI_ROOT_MYSQL_YANG_KUAT
DB_NAME=lanjut_db
DB_USER=lanjut_user
DB_PASSWORD=GANTI_SANDI_USER_MYSQL_YANG_KUAT

# Jalankan `npm run benih` otomatis saat kontainer API menyala (true / false)
JALANKAN_BENIH=true

# --- Domain, CORS, & URL API Frontend ----------------------------------------
# Ganti dengan domain HTTPS Anda di Dokploy (tanpa garis miring di akhir).
# Jika Anda memisahkan domain web dan API, pisahkan dengan koma:
# mis. CORS_ORIGINS=https://app.domain-anda.com,https://landing.domain-anda.com
CORS_ORIGINS=https://app.domain-anda.com

# URL API yang ditanam ke bundel Expo Web saat build.
# - Jika memakai 1 domain saja (diarahkan ke service `web` port 80):
#   EXPO_PUBLIC_API_URL=https://app.domain-anda.com/api/v1
# - Jika memakai domain terpisah untuk API (diarahkan ke service `api` port 4000):
#   EXPO_PUBLIC_API_URL=https://api.domain-anda.com/api/v1
EXPO_PUBLIC_API_URL=https://app.domain-anda.com/api/v1

# Jumlah reverse proxy di depan Express:
# - Isi 2 jika trafik lewat Traefik (Dokploy) -> Nginx (service `web`) -> Express (`api`)
# - Isi 1 jika trafik langsung dari Traefik (Dokploy) -> Express (`api`)
TRUST_PROXY=2
HEADER_IP_KLIEN=x-real-ip
SESI_UMUR_HARI=90

# --- Fitur Opsional: AI Ngobrol (OpenRouter) ---------------------------------
OPENROUTER_API_KEY=
EXPO_PUBLIC_MIKROFON_NGOBROL=0

# --- Fitur Opsional: Masuk dengan Google (OAuth) -----------------------------
GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# --- Fitur Opsional: Masuk dengan Kode Email (SMTP) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
