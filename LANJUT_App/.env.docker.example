# =============================================================================
# Templat Environment untuk Dokploy (Docker Compose) — LANJUT_App (Tanpa Nginx)
# Salin isi di bawah ini ke tab "Environment" pada layanan Compose di Dokploy.
# =============================================================================

# --- Lingkungan & Port -------------------------------------------------------
NODE_ENV=production
# Port kontainer/host untuk Web (Node serve) dan Backend API (Express)
# Nginx sekolah atau Dokploy dapat mengarahkan trafik ke kedua port ini:
WEB_PORT=3000
API_PORT=4000

# --- Basis Data MySQL 8 (service `db`) ---------------------------------------
DB_ROOT_PASSWORD=GANTI_SANDI_ROOT_MYSQL_YANG_KUAT
DB_NAME=lanjut_db
DB_USER=lanjut_user
DB_PASSWORD=GANTI_SANDI_USER_MYSQL_YANG_KUAT

# Jalankan `npm run benih` otomatis saat kontainer API menyala (true / false)
JALANKAN_BENIH=true

# --- Domain, CORS, & URL API Frontend ----------------------------------------
# Ganti dengan domain HTTPS tempat aplikasi web dibuka (tanpa garis miring di akhir).
CORS_ORIGINS=https://app.domain-sekolah.sch.id

# URL publik menuju Backend API yang akan dipanggil oleh browser / APK.
# - Jika Nginx sekolah mengarahkan path `/api/v1` di domain yang sama ke port API (4000):
#   EXPO_PUBLIC_API_URL=https://app.domain-sekolah.sch.id/api/v1
# - Jika menggunakan subdomain terpisah untuk API (mis. diarahkan ke port 4000):
#   EXPO_PUBLIC_API_URL=https://api.domain-sekolah.sch.id/api/v1
EXPO_PUBLIC_API_URL=https://app.domain-sekolah.sch.id/api/v1

# Jumlah reverse proxy di depan Express (mis. 1 untuk Nginx sekolah, atau 2 jika Nginx sekolah -> Traefik Dokploy)
TRUST_PROXY=1
HEADER_IP_KLIEN=x-real-ip
SESI_UMUR_HARI=90

# --- Fitur Opsional: AI Ngobrol (OpenRouter) ---------------------------------
OPENROUTER_API_KEY=
EXPO_PUBLIC_MIKROFON_NGOBROL=0

# --- Fitur Opsional: Masuk dengan Google (OAuth) -----------------------------
GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# --- Fitur Opsional: Masuk dengan Kode Email (SMTP) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
